# The Talk screen calls the backend at /api/chat (Vite proxies /api to http://127.0.0.1:8000).
# If the backend is down, Paw falls back to the scripted demo replies automatically.
VITE_PAW_API_URL=/api/chat

# true = skip the backend entirely and only use the scripted demo replies.
VITE_USE_MOCK_PAW=false
