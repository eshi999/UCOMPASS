# Copy this file to backend/.env and fill in what you need. backend/.env is git ignored.
# Everything is optional: with nothing set, Paw uses the local agent and browser speech.

# ---- Paw voice (ElevenLabs) ----
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL_ID=eleven_flash_v2_5
# ELEVENLABS_TIMEOUT_SECONDS=10

# ---- Hosted Foundry agent ----
# FOUNDRY_ENABLED=true
# FOUNDRY_RESPONSES_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>/agents/<agent>/endpoint/protocols/openai/responses?api-version=v1
# FOUNDRY_TIMEOUT_SECONDS=15
# FOUNDRY_API_KEY=            # optional; otherwise uses `az login` or azure-identity
